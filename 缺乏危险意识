local tweenService = game:GetService("TweenService")

local function showNotification()
    notifFrame.Visible = true
    notifFrame.Position = UDim2.new(1, 10, 1, -50)
    
    local slideIn = tweenService:Create(notifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, -190, 1, -50)})
    slideIn:Play()
    
    task.spawn(function()
        task.wait(7)
        local slideOut = tweenService:Create(notifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 10, 1, -50)})
        slideOut:Play()
        slideOut.Completed:Wait()
        notifFrame.Visible = false
    end)
end

task.spawn(function()
    while true do
        task.wait(30)
        showNotification()
    end
end)

